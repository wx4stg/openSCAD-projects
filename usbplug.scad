// Cover for WT-SANTA USB ports
//

$fn=100;

WALL_THICKNESS = 2.2;
USB_X = 12.05;
USB_Y = 4.62;
USB_Z = 16.02;
TAB_X = 11.7;
TAB_Y = 2.34;
TAB_Z = 8.76;
RING_THICKNESS = 1.5;
RING_LENGTH = 65;
RINGTIP_DIAMETER = 5;
HOLDER_CATCH_WIDTH = 1;
CABLE_LOOP = 25;

color("red") union() {
    // USB handle
    translate([-2*WALL_THICKNESS, -2*WALL_THICKNESS, -WALL_THICKNESS]) cube([USB_X+4*WALL_THICKNESS, USB_Y+4*WALL_THICKNESS, WALL_THICKNESS]);
    // rib to hold ring
    translate([-2*WALL_THICKNESS, -2*WALL_THICKNESS, RING_THICKNESS]) cube([USB_X+4*WALL_THICKNESS, USB_Y+4*WALL_THICKNESS, WALL_THICKNESS]);
    // make that a full I beam
    translate([-WALL_THICKNESS, -WALL_THICKNESS, 0]) cube([USB_X+2*WALL_THICKNESS, USB_Y+2*WALL_THICKNESS, RING_THICKNESS]);
    // USB tab
    translate([(USB_X-TAB_X)/2, -TAB_Y/2, RING_THICKNESS+WALL_THICKNESS]) cube([TAB_X, TAB_Y, TAB_Z]);
}

// TPU ring
color("aqua") {
    difference() {
        translate([-(WALL_THICKNESS+RING_THICKNESS), -(WALL_THICKNESS+RING_THICKNESS), 0]) cube([USB_X+2*RING_THICKNESS+2*WALL_THICKNESS, USB_Y+2*RING_THICKNESS+2*WALL_THICKNESS, RING_THICKNESS]);
        translate([-WALL_THICKNESS, -WALL_THICKNESS, -WALL_THICKNESS]) cube([USB_X+2*WALL_THICKNESS, USB_Y+2*WALL_THICKNESS, USB_Z+WALL_THICKNESS]);
    }
    translate([(USB_X-RING_THICKNESS)/2, USB_Y+WALL_THICKNESS+RING_THICKNESS, 0]) cube([RING_THICKNESS, WALL_THICKNESS, RING_THICKNESS]);
    // TPU strap
    translate([(USB_X-RING_THICKNESS)/2, USB_Y+2*WALL_THICKNESS, -WALL_THICKNESS]) cube([RING_THICKNESS, RING_THICKNESS, WALL_THICKNESS]);
    translate([(USB_X-RING_THICKNESS)/2, USB_Y+2*WALL_THICKNESS, -WALL_THICKNESS]) cube([RING_THICKNESS, RING_LENGTH, RING_THICKNESS]);
    // TPU clasp
    difference() {
        translate([-HOLDER_CATCH_WIDTH+(USB_X-RINGTIP_DIAMETER)/2, -HOLDER_CATCH_WIDTH+USB_Y+2*WALL_THICKNESS+RING_LENGTH, -WALL_THICKNESS]) cube([RINGTIP_DIAMETER+2*HOLDER_CATCH_WIDTH, RINGTIP_DIAMETER+2*HOLDER_CATCH_WIDTH, RING_THICKNESS]);
        translate([(USB_X)/2, USB_Y+2*WALL_THICKNESS+RING_LENGTH+RINGTIP_DIAMETER/2, -WALL_THICKNESS]) cylinder(d=RINGTIP_DIAMETER-0.2, h=RING_THICKNESS);

    }
    translate([(USB_X-RING_THICKNESS)/2, USB_Y+2*WALL_THICKNESS+RING_LENGTH+RINGTIP_DIAMETER, -WALL_THICKNESS]) cube([RING_THICKNESS, CABLE_LOOP, RING_THICKNESS]);
    translate([(USB_X-RING_THICKNESS)/2+RING_THICKNESS/2, USB_Y+2*WALL_THICKNESS+RING_LENGTH+RINGTIP_DIAMETER+CABLE_LOOP, 0.3]) sphere(d=RINGTIP_DIAMETER);

}